{
  "manifest_version": 3,
  "name": "SONU",
  "version": "0.1.0",
  "description": "Lets SONU, your local assistant, list, switch and close your tabs. Talks only to SONU on this computer.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@sonu.local",
      "strict_min_version": "128.0"
    }
  }
}
